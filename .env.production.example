# Copy this file to `.env` on your server and fill in every value below.
# Never commit the real `.env` file - it holds real secrets.

# ==============================================================
# Domain & URLs
# ==============================================================
# The domain you pointed at your server's IP address (A record).
DOMAIN=app.yourdomain.com
MAIN_URL=https://app.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com
NEXT_PUBLIC_BACKEND_URL=https://app.yourdomain.com/api
BACKEND_INTERNAL_URL=http://localhost:3000
TEMPORAL_ADDRESS=temporal:7233
IS_GENERAL=true
DISABLE_REGISTRATION=false

# ==============================================================
# Secrets - generate your own random values, never reuse examples
# ==============================================================
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# Used by docker-compose.prod.yaml to set the Postgres passwords.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
TEMPORAL_POSTGRES_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_PASSWORD

DATABASE_URL=postgresql://postiz-user:REPLACE_WITH_A_RANDOM_PASSWORD@postiz-postgres:5432/postiz-db-local
REDIS_URL=redis://postiz-redis:6379

# ==============================================================
# Your own image (built by .github/workflows/deploy-production-image.yml)
# ==============================================================
POSTIZ_IMAGE=ghcr.io/manalmarzouk2020-bit/postiz-salesbrain:latest

# ==============================================================
# Storage (local disk is fine to start; switch to Cloudflare R2 later
# if you need uploads to survive a server rebuild / scale to multiple
# servers)
# ==============================================================
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# ==============================================================
# AI Sales Brain
# ==============================================================
# Required for the Sales Brain AI decision engine (leads, replies,
# playbook, coaching, forecasting, etc). Get one at platform.openai.com
OPENAI_API_KEY=

# Nothing else Sales-Brain-specific goes here - each organization
# connects its own WhatsApp/Messenger/Instagram/Telegram from the
# in-app "Channels" tab, not from environment variables.

# ==============================================================
# Optional: Stripe billing (only if you want to charge clients directly
# through this app instead of billing them yourself)
# ==============================================================
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SIGNING_KEY=
